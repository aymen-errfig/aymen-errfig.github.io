---
import { Image } from "astro:assets";
const { id, title, description, tags, imageUrl, isNew } = Astro.props as {
	id: string;
	title: string;
	description: string;
	tags: string[];
	imageUrl: string;
	isNew: boolean;
};
const images = import.meta.glob<{ default: ImageMetadata }>(
	"/src/assets/img/**/*.{jpeg,jpg,png,gif}",
);
if (!images[imageUrl]) {
	throw new Error(`Image not found: ${imageUrl}`);
}
const image = images[imageUrl]();
---

<a href={`/projects/${id}`} aria-label={`View details for ${title}`}
	><div
		class="flex flex-col min-w-90 card bg-white relative h-full transition cursor-pointer duration-1000 hover:shadow-none"
	>
		<div class="absolute gap-2 flex top-2 right-2">
			<div class="flex bg-accent border">
				{
					isNew && (
						<span class="p-2 text-xs border spacegrotesk uppercase text-text">
							NEW
						</span>
					)
				}
			</div>
		</div>
		<div class="h-50 bg-gray-300 relative overflow-hidden">
			<Image
				class={"object-cover w-full h-full"}
				src={image}
				alt={title}
			/>
		</div>
		<div class="flex grow flex-col gap-4 p-4 border-t-2 bg-white border">
			<h3 class="text-lg font-bold uppercase">{title}</h3>
			<p class="text-xs text-gray-800">
				{description}
			</p>
			<div class="flex gap-1.5 mt-auto flex-wrap">
				{
					tags.map((tag) => (
						<span class="bg-gray-300 text-text p-2 text-2xs border spacegrotesk uppercase">
							{tag}
						</span>
					))
				}
			</div>
		</div>
	</div>
</a>
