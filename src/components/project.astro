---
interface ProjectProps {
	title: string;
	description: string;
	tags: string[];
	imageUrl: string;
	isNew: boolean;
}

const { title, description, tags, imageUrl, isNew } =
	Astro.props as ProjectProps;
---

<div class="flex flex-col min-w-90 card bg-white relative">
	<div class="flex gap-2 absolute top-2 right-2 bg-accent border">
		{
			isNew && (
				<span class="p-2 text-xs border spacegrotesk uppercase text-text">
					NEW
				</span>
			)
		}
	</div>
	<div class="h-60 bg-gray-300"></div>
	<div class="flex flex-col gap-4 p-4 border-t-2">
		<h3 class="text-lg font-bold uppercase">{title}</h3>
		<p class="text-xs text-gray-800">
			{description}
		</p>
		<div class="flex gap-2">
			{
				tags.map((tag) => (
					<span class="bg-gray-300 text-text p-2 text-xs border spacegrotesk uppercase">
						{tag}
					</span>
				))
			}
		</div>
	</div>
</div>
