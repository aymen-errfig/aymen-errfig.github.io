---
import { Image } from "astro:assets";
import Profile from "../assets/img/profile.png";
import { Icon } from "astro-icon/components";
---

<section class="p-8 flex items-center justify-center" id="profile">
    <div class="w-[80%] items-center flex">
        <div class="w-auto grow flex justify-center">
            <div class="w-[70%]">
                <Image
                    src={Profile}
                    alt={"Aymen Errfig profile"}
                    fetchpriority={"high"}
                    loading={"eager"}
                />
            </div>
        </div>
        <div class="w-[60%] flex flex-col gap-4 mt-4">
            <h1 class="text-4xl">
                Aymen Errfig <span>Frontend Dev</span> && <span
                    >UI / UX Designer</span
                >
            </h1>
            <p class="text-sm">
                I’m a software engineer focused on building web and mobile
                experiences that stay fast and reliable, even on shaky
                connections. I pair intuitive UX with clean, type-safe code,
                specializing in offline-first systems and real-time features. As
                a lifelong learner, I enjoy helping teams write cleaner code,
                untangle tough bugs, and adopt smarter AI workflows.
            </p>
            <div class="flex gap-2 mt-6">
                <button
                    aria-label="resume download button"
                    class="bg-white text-gray-900 text-xs uppercase font-bold px-4"
                >
                    <Icon name="download" size={16} />
                    Download resume</button
                >
                <a
                    aria-label="linkedin link"
                    href="https://www.linkedin.com/in/errfig-aymen-dev/"
                    target="_blank"
                    rel="noopener noreferrer"
                >
                    <button
                        aria-label="linkedin link"
                        class="bg-blue-600 text-white rounded-full w-10 h-10 p-0 ml-5"
                        ><Icon size={16} name="linkedin" /></button
                    >
                </a>
                <a
                    aria-label="github link"
                    href="https://github.com/aymen-errfig"
                    target="_blank"
                    rel="noopener noreferrer"
                >
                    <button
                        aria-label="github link"
                        class="bg-black text-white rounded-full w-10 h-10 p-0"
                        ><Icon size={16} name="github" /></button
                    >
                </a>
            </div>
        </div>
    </div>
</section>
