---
import { Icon } from "astro-icon/components";
import { getCollection } from "astro:content";

const skills_collection = await getCollection("skills");
---

<section
    id="skills"
    class="bg-white h-fit p-12 flex flex-col items-center gap-12"
>
    <div class="flex flex-col gap-1 justify-center items-center">
        <h4 class="label uppercase">Selected Skills</h4>
        <h2 class="uppercase text-2xl text-text">SKILLS and technologies</h2>
    </div>
    <div class="flex flex-wrap gap-4 w-[80%]">
        {
            skills_collection.map((skill) => (
                <div
                    class="skill"
                    style={{
                        background: skill.data.bg_color,
                        color: skill.data.text_color || "#fff",
                    }}
                >
                    <Icon name={skill.data.icon} size={16} />
                    {skill.data.title}
                </div>
            ))
        }
    </div>
</section>
