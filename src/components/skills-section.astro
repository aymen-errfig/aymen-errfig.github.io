---
import { Icon } from "astro-icon/components";
import { getCollection } from "astro:content";

const skills_collection = await getCollection("skills");
---

<section
    id="skills"
    class="bg-white h-fit py-14 flex flex-col items-center gap-12"
>
    <div class="flex flex-col gap-1 justify-center items-center">
        <h2 class="label uppercase">Selected Skills</h2>
        <h4 class="text-3xl text-text font-heading">Skills and technologies</h4>
    </div>
    <div class="flex flex-wrap gap-4 w-[80%]">
        {
            skills_collection.map((skill) => (
                <div
                    class="skill max-sm:w-full"
                    style={{
                        background: skill.data.bg_color,
                        color: skill.data.text_color || "#fff",
                    }}
                >
                    <Icon name={skill.data.icon} size={16} />
                    {skill.data.title}
                </div>
            ))
        }
    </div>
</section>
