---
import { Icon } from "astro-icon/components";
---

<footer
    class="bg-gray-900 text-white w-full py-8 flex flex-col items-center justify-center gap-4"
>
    <div class="flex flex-col gap-1 justify-center items-center">
        <h2 class="label uppercase text-accent">Contact</h2>
        <h4 class="uppercase text-2xl font-heading">Let's work together!</h4>
    </div>
    <div class="flex flex-col gap-4 w-[80%]">
        <div class="flex flex-col gap-2">
            <h3 class="font-bold uppercase">Email</h3>
            <a
                href="mailto:errfig.aymen.dev@gmail.com"
                class="text-sm font-medium hover:text-gray-700 transition-all duration-300"
            >
                errfig.aymen.dev@gmail.com
            </a>
        </div>
        <div class="flex flex-col gap-2">
            <h3 class="font-bold uppercase">Socials</h3>
            <div class="flex gap-4">
                <a
                    class="max-md:ml-auto"
                    aria-label="linkedin link"
                    href="https://www.linkedin.com/in/errfig-aymen-dev/"
                    target="_blank"
                    rel="noopener noreferrer"
                >
                    <button
                        aria-label="linkedin link"
                        class="bg-blue-600 text-white rounded-full w-10 h-10 p-0 ml-5"
                        ><Icon size={16} name="linkedin" /></button
                    >
                </a>
                <a
                    aria-label="github link"
                    href="https://github.com/aymen-errfig"
                    target="_blank"
                    rel="noopener noreferrer"
                >
                    <button
                        aria-label="github link"
                        class="bg-black text-white rounded-full w-10 h-10 p-0"
                        ><Icon size={16} name="github" /></button
                    >
                </a>
            </div>
        </div>
    </div>
</footer>
