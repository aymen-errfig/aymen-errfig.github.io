---
import { ClientRouter } from "astro:transitions";
import { Font } from "astro:assets";
import { SEO } from "astro-seo";
---

<!doctype html>
<html lang="en">
	<ClientRouter />

	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width" />
	<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
	<link rel="icon" href="/favicon.ico" />
	<meta name="generator" content={Astro.generator} />
	<SEO
		title="Aymen Errfig | Software Developer"
		description="aymen errfig is a software engineer"
	/>
	<title>Astro Basics</title>
	<Font cssVariable="--font-display" />
	<Font cssVariable="--font-heading" />
	<Font cssVariable="--font-label" />
	<Font cssVariable="--font-label-small" />

	<body
		class="min-h-screen overflow-y-auto snap-y snap-mandatory scroll-smooth"
	>
		<slot />
	</body>
</html>
