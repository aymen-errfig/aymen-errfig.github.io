---
import { ClientRouter } from "astro:transitions";
import { Font } from "astro:assets";
import { SEO } from "astro-seo";
---

<!doctype html>
<html lang="en">
	<ClientRouter />

	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width" />
	<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
	<link rel="icon" href="/favicon.ico" />
	<meta name="generator" content={Astro.generator} />
	<SEO
		title="Aymen Errfig | Frontend Engineer"
		description="Aymen Errfig is a Frontend Engineer and UI/UX Designer specializing in building web and mobile experiences that are fast, reliable, and intuitive. Explore his portfolio to see his work and skills."
		openGraph={{
			basic: {
				title: "Aymen Errfig | Frontend Engineer",
				url: "https://aymen-errfig.me",
				image: "https://aymen-errfig.me/og-image.png",
				type: "website",
			},
			optional: {
				description:
					"Aymen Errfig is a Frontend Engineer and UI/UX Designer specializing in building web and mobile experiences that are fast, reliable, and intuitive. Explore his portfolio to see his work and skills.",
				siteName: "Aymen Errfig Portfolio",
				locale: "en_US",
				determiner: "the",
				localeAlternate: ["en_US", "fr_FR"],
			},
		}}
	/>
	<title>Astro Basics</title>
	<Font cssVariable="--font-display" />
	<Font cssVariable="--font-heading" />
	<Font cssVariable="--font-label" />
	<Font cssVariable="--font-label-small" />

	<body
		class="min-h-screen overflow-y-auto snap-y snap-mandatory scroll-smooth"
	>
		<slot />
	</body>
</html>
