---
import Header from "../../components/header.astro";
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";

export async function getStaticPaths() {
    const projects = await getCollection("projects");

    const paths = projects.map((project) => {
        return { params: { project: project.data.id } };
    });
    return paths;
}

const { project } = Astro.params;
const projectData = (await getCollection("projects").then((projects) =>
    projects.find((p) => p.data.id === project),
))!;

const images = import.meta.glob<{ default: ImageMetadata }>(
    "/src/assets/img/**/*.{jpeg,jpg,png,gif}",
);
if (!images[projectData.data.imageUrl]) {
    throw new Error(`Image not found: ${projectData.data.imageUrl}`);
}
const project_image = images[projectData.data.imageUrl]();
---

<Layout>
    <main class="w-full flex flex-col items-center scroll-smooth">
        <Header />
        <div class="mt-30 pb-10 flex flex-col gap-4 w-[80%] justify-start">
            <div class="flex w-full justify-between">
                <a
                    href="/projects"
                    class="text-sm text-gray-500 hover:text-gray-700 transition-all duration-300"
                >
                    <span class="mr-2">←</span> Back to Projects
                </a>
            </div>
            <div class="flex justify-between items-center">
                <h2 class="text-3xl uppercase">
                    {`${projectData.data.title}`}
                </h2>
                <a href={projectData.data.imageUrl} target="_blank"
                    ><button class="bg-gray-900 text-white"
                        ><Icon name={"github"} />View on GitHub
                    </button></a
                >
            </div>
            <div class="gap-3">
                <Image
                    src={project_image}
                    alt=""
                    class={"object-cover w-full h-full"}
                    loading={"eager"}
                    fetchpriority="high"
                />
            </div>
            <div class="grid grid-cols-2 gap-3 mt-4 max-md:grid-cols-1">
                <div
                    class="flex flex-col gap-2 mt-4 justify-between border-l-4 border-accent p-4 py-2"
                >
                    <h3 class="font-bold uppercase">Description</h3>
                    <p class="text-xs text-gray-800">
                        {projectData.data.description}
                    </p>
                </div>
                <div
                    class="flex flex-col gap-2 justify-between border-l-4 border-blue-600 p-4 py-2"
                >
                    <h3 class="flex gap-1 items-center font-bold uppercase">
                        <Icon name={"technologies"} color="#000000" /> Technologies
                    </h3>
                    <div class="flex gap-1.5 mt-auto flex-wrap">
                        {
                            projectData.data.tags.map((tag) => (
                                <span class="bg-gray-300 text-text p-2 text-xs border spacegrotesk uppercase">
                                    {tag}
                                </span>
                            ))
                        }
                    </div>
                </div>
            </div>
        </div>
    </main>
</Layout>
