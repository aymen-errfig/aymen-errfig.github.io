---
import { Image } from "astro:assets";
import Header from "../../components/header.astro";
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";

const images = import.meta.glob<{ default: ImageMetadata }>(
    "/src/assets/img/**/*.{jpeg,jpg,png,gif}",
);
const projects = await getCollection("projects");
---

<Layout>
    <main class="w-full flex flex-col items-center scroll-smooth">
        <Header />
        <div class="mt-30 pb-10 flex flex-col gap-12 w-[80%] justify-start">
            <div class="flex flex-col gap-3 w-full items-center">
                <h1 class="text-6xl">My Projects</h1>
                <p class="text-gray-600">
                    Welcome to my projects page! where you can find all of my
                    work.
                </p>
            </div>
            <div class="grid grid-cols-2 gap-4">
                {
                    projects.map((project) => (
                        <div class="bg-white card min-h-80 flex items-end relative">
                            <div class="absolute inset-0 backdrop-brightness-70 bg-black/10 hover:bg-transparent hover:backdrop-brightness-100 transition duration-300" />
                            <Image
                                src={images[project.data.imageUrl]()}
                                alt={project.data.title}
                                class={
                                    "object-cover w-full h-full shadow-2xl transition-all duration-300"
                                }
                            />
                            <div class="flex flex-col gap-2 absolute mb-4 ml-4">
                                <h3 class="text-xl font-bold text-white">
                                    {project.data.title}
                                </h3>
                                <div class="flex flex-wrap gap-2">
                                    {project.data.tags.map((tag) => (
                                        <span class="bg-gray-300 text-text p-2 text-2xs border spacegrotesk uppercase">
                                            {tag}
                                        </span>
                                    ))}
                                </div>
                            </div>
                            <div class="flex gap-2 justify-center">
                                <div />
                            </div>
                        </div>
                    ))
                }
            </div>
        </div>
    </main>
</Layout>
