		<ProfileSection />
		<div class="bg-primary text-white w-full p-8 flex gap-4">
			<p class="label text-white">SKILLS</p>
			<p class="label text-white">SKILLS</p>
			<p class="label text-white">SKILLS</p>
			<p class="label text-white">SKILLS</p>
